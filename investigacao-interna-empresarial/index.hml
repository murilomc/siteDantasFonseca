    }

    .copyright {
      margin-top: 24px;
      color: rgba(255,255,255,.56);
      font-size: 13px;
    }

    .whatsapp-float {
      position: fixed;
      right: 20px;
      bottom: 20px;
      z-index: 60;
      min-height: 52px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 0 18px;
      color: #fff;
      background: #1f6f56;
      border-radius: 999px;
      box-shadow: 0 12px 30px rgba(31,111,86,.32);
      text-decoration: none;
      font-weight: 800;
    }

    .whatsapp-float:hover {
      color: #fff;
      background: #185b46;
    }

    @media (max-width: 980px) {
      .related-grid {
        grid-template-columns: 1fr 1fr;
      }
    }

    @media (max-width: 650px) {
      .faq-grid,
      .related-grid {
        grid-template-columns: 1fr;
      }

      .final-cta-grid {
        grid-template-columns: 1fr;
      }

      .footer-grid {
        grid-template-columns: 1fr;
      }

      .whatsapp-float {
        right: 14px;
        bottom: 14px;
        min-height: 48px;
        padding: 0 16px;
        font-size: 14px;
      }
    }


    /* AJUSTES RESPONSIVOS: problem-grid, timeline e topics */
    .problem-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
      margin-top: 30px;
    }

    .problem {
      display: flex;
      flex-direction: column;
      gap: 9px;
      min-width: 0;
      padding: 24px;
      border: 1px solid rgba(255,255,255,.14);
      border-radius: 18px;
      background: rgba(255,255,255,.055);
    }

    .problem strong {
      display: block;
      margin: 0;
      color: #fff;
      font-size: 1.02rem;
      line-height: 1.35;
    }

    .problem span {
      display: block;
      margin: 0;
      color: rgba(255,255,255,.74);
      line-height: 1.65;
    }

    .timeline {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 16px;
      margin-top: 30px;
    }

    .stage {
      display: flex;
      flex-direction: column;
      min-width: 0;
      min-height: 190px;
      padding: 22px;
      border: 1px solid var(--lp-line);
      border-radius: 18px;
      background: #fff;
      box-shadow: 0 10px 28px rgba(15,33,55,.06);
    }

    .stage small {
      display: block;
      margin-bottom: 10px;
      color: var(--lp-sage-dark);
      font-size: .76rem;
      font-weight: 800;
      letter-spacing: .05em;
      text-transform: uppercase;
    }

    .stage strong {
      display: block;
      margin-bottom: 10px;
      color: var(--lp-navy);
      font-size: 1.05rem;
      line-height: 1.35;
    }

    .stage p {
      margin: 0;
      color: var(--lp-muted);
      line-height: 1.62;
    }

    .topics {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 18px;
      margin-top: 30px;
    }

    .topic {
      min-width: 0;
      padding: 24px;
      border: 1px solid var(--lp-line);
      border-radius: 18px;
      background: #fff;
      box-shadow: 0 10px 28px rgba(15,33,55,.05);
    }

    .topic h3 {
      margin: 0 0 10px;
      color: var(--lp-navy);
      font-size: 1.05rem;
      line-height: 1.35;
    }

    .topic p {
      margin: 0;
      color: var(--lp-muted);
      line-height: 1.65;
    }

    @media (max-width: 980px) {
      .problem-grid {
        grid-template-columns: 1fr 1fr;
      }

      .timeline {
        grid-template-columns: 1fr 1fr;
      }

      .topics {
        grid-template-columns: 1fr 1fr;
      }
    }

    @media (max-width: 650px) {
      .problem-grid,
      .timeline,
      .topics {
        grid-template-columns: 1fr;
        gap: 14px;
      }

      .problem,
      .stage,
      .topic {
        width: 100%;
        min-height: 0;
        padding: 20px;
        border-radius: 16px;
      }

      .problem strong,
      .stage strong,
      .topic h3 {
        display: block;
        margin-bottom: 8px;
        font-size: 1rem;
        line-height: 1.35;
      }

      .problem span,
      .stage p,
      .topic p {
        display: block;
        margin: 0;
        font-size: .96rem;
        line-height: 1.6;
      }

      .stage small {
        display: block;
        margin-bottom: 8px;
        font-size: .72rem;
      }
    }


    /* CORREÇÃO ESPECÍFICA: cards da estratégia de defesa do PAR */
    .par-defense-section {
      overflow: visible;
    }

    .par-defense-section .section-head h2,
    .par-defense-section .section-head p {
      color: #ffffff;
    }

    .par-defense-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
      margin-top: 30px;
    }

    .par-defense-card {
      display: block;
      min-width: 0;
      padding: 24px;
      border: 1px solid rgba(255,255,255,.18);
      border-radius: 18px;
      background: rgba(255,255,255,.08);
      box-sizing: border-box;
    }

    .par-defense-card h3 {
      display: block;
      margin: 0 0 10px 0;
      color: #ffffff !important;
      font-family: inherit;
      font-size: 1.06rem;
      font-weight: 800;
      line-height: 1.35;
    }

    .par-defense-card p {
      display: block;
      margin: 0;
      color: rgba(255,255,255,.82) !important;
      font-family: inherit;
      font-size: .98rem;
      font-weight: 400;
      line-height: 1.65;
    }

    @media (max-width: 780px) {
      .par-defense-grid {
        grid-template-columns: 1fr;
        gap: 14px;
      }

      .par-defense-card {
        width: 100%;
        padding: 20px;
        border-radius: 16px;
      }

      .par-defense-card h3 {
        margin-bottom: 8px;
        font-size: 1rem;
        line-height: 1.35;
      }

      .par-defense-card p {
        font-size: .96rem;
        line-height: 1.6;
      }
    }

  
/* Blocos específicos de Investigação Interna Empresarial */
.investigation-grid,.comparison-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px;margin-top:30px}
.investigation-card,.comparison-card{display:block;padding:24px;border-radius:18px;box-sizing:border-box}
.investigation-card{border:1px solid rgba(20,40,35,.14);background:#fff}
.investigation-card h3{display:block;margin:0 0 10px;color:#1f2933!important;font-size:1.06rem;line-height:1.35}
.investigation-card p{display:block;margin:0;color:#4b5563!important;line-height:1.65}
.comparison-card{border:1px solid rgba(20,40,35,.14);background:#fff}
.comparison-card h3{display:block;margin:0 0 10px;color:#1f2933!important;font-size:1.08rem;line-height:1.35}
.comparison-card p{display:block;margin:0;color:#4b5563!important;line-height:1.65}
@media(max-width:780px){
  .investigation-grid,.comparison-grid{grid-template-columns:1fr;gap:14px}
  .investigation-card,.comparison-card{padding:20px;border-radius:16px}
  .investigation-card h3,.comparison-card h3{margin-bottom:8px;font-size:1rem}
  .investigation-card p,.comparison-card p{font-size:.96rem;line-height:1.6}
}

</style>
</head>

