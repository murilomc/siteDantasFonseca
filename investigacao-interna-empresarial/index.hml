  <script type="application/ld+json">{"@context": "https://schema.org", "@graph": [{"@type": "Organization", "@id": "https://dantasfonseca.adv.br/#organization", "name": "Dantas Fonseca Advocacia", "url": "https://dantasfonseca.adv.br/"}, {"@type": "WebPage", "@id": "https://dantasfonseca.adv.br/investigacao-interna-empresarial/#webpage", "url": "https://dantasfonseca.adv.br/investigacao-interna-empresarial/", "name": "Advogado para Investigação Interna Empresarial | Dantas Fonseca", "description": "Assessoria jurídica em investigações internas empresariais envolvendo denúncias, fraude, corrupção, licitações, contratos públicos, terceiros, compliance e possíveis repercussões perante autoridades.", "inLanguage": "pt-BR"}, {"@type": "LegalService", "@id": "https://dantasfonseca.adv.br/investigacao-interna-empresarial/#service", "name": "Assessoria Jurídica em Investigação Interna Empresarial", "url": "https://dantasfonseca.adv.br/investigacao-interna-empresarial/", "provider": {"@id": "https://dantasfonseca.adv.br/#organization"}, "areaServed": {"@type": "Country", "name": "Brasil"}, "serviceType": ["Investigação interna empresarial", "Investigações corporativas", "Compliance", "Lei Anticorrupção", "Fraudes em licitações e contratos", "Integridade empresarial"]}, {"@type": "FAQPage", "@id": "https://dantasfonseca.adv.br/investigacao-interna-empresarial/#faq", "mainEntity": [{"@type": "Question", "name": "O que é uma investigação interna empresarial?", "acceptedAnswer": {"@type": "Answer", "text": "É uma apuração estruturada realizada pela própria organização para esclarecer denúncias, indícios ou suspeitas de irregularidades, identificar fatos e envolvidos, preservar evidências e subsidiar decisões jurídicas, de governança e de remediação."}}, {"@type": "Question", "name": "Quando uma empresa deve considerar uma investigação interna?", "acceptedAnswer": {"@type": "Answer", "text": "Quando surgirem denúncias, alertas de auditoria ou compliance, inconsistências documentais, suspeitas de fraude ou corrupção, problemas em licitações ou contratos públicos, atuação inadequada de terceiros ou fatos que possam gerar responsabilização perante autoridades."}}, {"@type": "Question", "name": "Uma denúncia interna significa que houve irregularidade?", "acceptedAnswer": {"@type": "Answer", "text": "Não. A denúncia é um ponto de partida. A investigação deve testar as alegações de forma objetiva, reunir elementos favoráveis e desfavoráveis e evitar conclusões antecipadas."}}, {"@type": "Question", "name": "Quais documentos podem ser relevantes?", "acceptedAnswer": {"@type": "Answer", "text": "Contratos, mensagens corporativas, documentos contábeis, registros de pagamentos, políticas internas, relatórios de auditoria, registros de acesso, documentos de licitações e contratos públicos e outros materiais relacionados ao escopo da apuração."}}, {"@type": "Question", "name": "É possível entrevistar empregados e terceiros?", "acceptedAnswer": {"@type": "Answer", "text": "Sim, quando pertinente e juridicamente adequado. As entrevistas devem ser planejadas de acordo com o escopo, a posição do entrevistado, os documentos já analisados e as regras internas aplicáveis."}}, {"@type": "Question", "name": "Como preservar a confidencialidade?", "acceptedAnswer": {"@type": "Answer", "text": "O acesso deve ser limitado às pessoas necessárias, com definição de governança, armazenamento seguro de documentos, controle de comunicações e avaliação jurídica sobre o tratamento das informações produzidas."}}, {"@type": "Question", "name": "O que fazer se a investigação identificar possível ato contra a Administração Pública?", "acceptedAnswer": {"@type": "Answer", "text": "A empresa deve avaliar os fatos, as provas, os riscos de responsabilização, medidas de remediação e as alternativas jurídicas disponíveis, que podem incluir defesa, cooperação com autoridades ou análise de eventual acordo de leniência."}}, {"@type": "Question", "name": "A investigação interna pode ser relevante para um acordo de leniência?", "acceptedAnswer": {"@type": "Answer", "text": "Sim. A CGU prevê mecanismo para empresas que identificaram indícios de ilícitos, mas ainda precisam concluir apurações internas e reunir provas antes de eventual proposta de acordo de leniência."}}, {"@type": "Question", "name": "A investigação substitui o programa de integridade?", "acceptedAnswer": {"@type": "Answer", "text": "Não. Ela é uma ferramenta de detecção e resposta. Um programa de integridade efetivo também envolve prevenção, canais de denúncia, controles, treinamento, gestão de riscos e monitoramento."}}, {"@type": "Question", "name": "O resultado da investigação pode levar a medidas corretivas?", "acceptedAnswer": {"@type": "Answer", "text": "Sim. Conforme os fatos, podem ser avaliadas medidas disciplinares, revisão de controles, aperfeiçoamento de políticas, gestão de terceiros, restituição de valores, comunicação a autoridades ou outras providências."}}, {"@type": "Question", "name": "É importante definir um escopo antes de começar?", "acceptedAnswer": {"@type": "Answer", "text": "Sim. Um escopo claro ajuda a definir quais alegações serão apuradas, quais documentos serão preservados, quem participará do trabalho e quais questões jurídicas precisam ser respondidas."}}, {"@type": "Question", "name": "Quando procurar assessoria jurídica externa?", "acceptedAnswer": {"@type": "Answer", "text": "É especialmente recomendável quando a denúncia envolve alta administração, agentes públicos, licitações, contratos governamentais, possível corrupção ou fraude, conflito interno de interesses, risco de investigação governamental ou necessidade de independência na apuração."}}]}]}</script>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Libre+Baskerville:wght@400;700&display=swap" rel="stylesheet" />

  <link rel="stylesheet" href="/assets/css/area.css" />

  <style>
    :root {
      --lp-bg: #f7f4ee;
      --lp-surface: #ffffff;
      --lp-soft: #edf0eb;
      --lp-ink: #17202c;
      --lp-muted: #68717c;
      --lp-sage: #6e7c65;
      --lp-sage-dark: #4f5e49;
      --lp-gold: #b48a4c;
      --lp-gold-dark: #8a6634;
      --lp-navy: #101927;
      --lp-dark: #14231c;
      --lp-line: #e5e0d7;
      --lp-shadow: 0 20px 55px rgba(16,25,39,.12);
      --lp-radius: 24px;
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }

    body {
      margin: 0;
      color: var(--lp-ink);
      background: var(--lp-bg);
      font-family: Inter, Arial, sans-serif;
      line-height: 1.7;
    }

    h1, h2, h3 {
      margin: 0;
      font-family: "Libre Baskerville", Georgia, serif;
      line-height: 1.15;
    }

    h1 {
      font-size: clamp(2.2rem, 4.7vw, 4.35rem);
      letter-spacing: -.035em;
    }

    h2 {
      font-size: clamp(2rem, 4vw, 3.35rem);
      letter-spacing: -.03em;
    }

    h3 { font-size: 1.2rem; }
    p { margin: 0; }
    section { padding: 92px 0; }

    .lp-container {
      width: min(1180px, calc(100% - 40px));
      margin-inline: auto;
    }

    .eyebrow {
      display: inline-block;
      margin-bottom: 14px;
      color: var(--lp-sage-dark);
      font-size: .78rem;
      font-weight: 800;
      letter-spacing: .15em;
      text-transform: uppercase;
    }

    .lp-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 49px;
      padding: 13px 21px;
      border: 1px solid transparent;
      border-radius: 8px;
      color: #fff;
      background: var(--lp-gold);
      text-decoration: none;
      font-weight: 800;
    }

    .lp-button:hover { background: var(--lp-gold-dark); }

    .lp-button.secondary {
      color: var(--lp-sage-dark);
      background: transparent;
      border-color: var(--lp-sage);
    }

    .breadcrumb-wrap {
      padding: 18px 0;
      background: #f0eee8;
      border-bottom: 1px solid var(--lp-line);
    }

    .breadcrumb {
      display: flex;
      flex-wrap: wrap;
      gap: 9px;
      margin: 0;
      padding: 0;
      list-style: none;
      color: var(--lp-muted);
      font-size: .88rem;
    }

    .breadcrumb li:not(:last-child)::after {
      content: "/";
      margin-left: 9px;
      color: #9ba29e;
    }

    .breadcrumb a {
      color: inherit;
      text-decoration: none;
    }

    .lp-hero {
      padding: 74px 0 92px;
      background:
        radial-gradient(circle at 86% 18%, rgba(180,138,76,.18), transparent 28%),
        linear-gradient(135deg, #f8f6f1 0%, #e8ede7 100%);
    }

    .lp-hero-grid {
      display: grid;
      grid-template-columns: 1.12fr .88fr;
      gap: 56px;
      align-items: center;
    }

    .lp-hero-copy h1 {
      max-width: 760px;
      color: var(--lp-navy);
    }

    .lp-hero-copy .lead {
      max-width: 760px;
      margin: 26px 0 30px;
      color: #53615a;
      font-size: clamp(1.05rem, 2vw, 1.28rem);
    }

    .lp-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
    }

    .lp-proof {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      margin-top: 34px;
    }

    .lp-proof div {
      padding: 18px;
      border: 1px solid var(--lp-line);
      border-radius: 16px;
      background: rgba(255,255,255,.72);
    }

    .lp-proof strong {
      display: block;
      margin-bottom: 4px;
      color: var(--lp-navy);
    }

    .lp-proof span {
      color: var(--lp-muted);
      font-size: .88rem;
    }

    .lp-hero-card {
      padding: 34px;
      border-radius: var(--lp-radius);
      color: #fff;
      background: var(--lp-dark);
      box-shadow: var(--lp-shadow);
    }

    .lp-hero-card .eyebrow { color: #d6be94; }

    .lp-hero-card h2 {
      margin-bottom: 20px;
      color: #fff;
      font-size: clamp(1.65rem, 3vw, 2.2rem);
    }

    .checks {
      display: grid;
      gap: 14px;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .checks li {
      position: relative;
      padding-left: 28px;
    }

    .checks li::before {
      content: "✓";
      position: absolute;
      left: 0;
      color: #e3c17e;
      font-weight: 900;
    }

    .trust {
      padding: 24px 0;
      color: #fff;
      background: var(--lp-sage-dark);
    }

    .trust .lp-container {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 16px;
      text-align: center;
      font-weight: 700;
    }

    .section-head {
      max-width: 830px;
      margin-bottom: 46px;
    }

    .section-head h2 { color: var(--lp-navy); }

    .section-head p {
      margin-top: 18px;
      color: var(--lp-muted);
      font-size: 1.04rem;
    }

    .intro-grid {
      display: grid;
      grid-template-columns: 1.05fr .95fr;
      gap: 46px;
      align-items: start;
    }

    .intro-copy p {
      margin-top: 18px;
      color: var(--lp-muted);
      font-size: 1.02rem;
    }

    .legal-box {
      padding: 30px;
      border-left: 5px solid var(--lp-gold);
      border-radius: 0 20px 20px 0;
      color: #fff;
      background: var(--lp-navy);
    }

    .legal-box h3 {
      margin-bottom: 14px;
      color: #fff;
    }

    .legal-box p {
      color: rgba(255,255,255,.76);
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
    }

    .card {
      padding: 28px;
      border: 1px solid var(--lp-line);
      border-radius: 22px;
      background: #fff;
      box-shadow: 0 10px 30px rgba(16,25,39,.06);
    }

    .card-number {
      display: grid;
      place-items: center;
      width: 46px;
      height: 46px;
      margin-bottom: 20px;
      border-radius: 50%;
      color: var(--lp-sage-dark);
      background: var(--lp-soft);
      font-weight: 800;
    }

    .card h3 {
      margin-bottom: 12px;
      color: var(--lp-navy);
    }

    .card p {
      color: var(--lp-muted);
    }

    .notification {
      color: #fff;
      background: var(--lp-dark);
    }

    .notification .eyebrow { color: #d6be94; }
    .notification .section-head h2 { color: #fff; }
    .notification .section-head p { color: rgba(255,255,255,.74); }

    .notice-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 18px;
    }

    .notice-item {
      padding: 24px;
      border: 1px solid rgba(255,255,255,.14);
      border-radius: 18px;
      background: rgba(255,255,255,.055);
    }

    .notice-item strong {
      display: block;
      margin-bottom: 8px;
      color: #fff;
    }

    .notice-item span {
      color: rgba(255,255,255,.72);
    }

    .comparison {
      background: #fff;
    }

    .comparison-table {
      width: 100%;
      border-collapse: collapse;
      overflow: hidden;
      border-radius: 18px;
      background: #fff;
      box-shadow: 0 10px 30px rgba(16,25,39,.07);
    }

    .comparison-table th,
    .comparison-table td {
      padding: 20px;
      border: 1px solid var(--lp-line);
      text-align: left;
      vertical-align: top;
    }

    .comparison-table th {
      color: #fff;
      background: var(--lp-sage-dark);
    }

    .comparison-table td:first-child {
      width: 22%;
      color: var(--lp-navy);
      font-weight: 800;
    }

    .comparison-table td {
      color: var(--lp-muted);
    }

    .defense {
      background: var(--lp-soft);
    }

    .defense-grid {
      display: grid;
      grid-template-columns: .82fr 1.18fr;
      gap: 52px;
      align-items: start;
    }

    .steps {
      display: grid;
      gap: 16px;
    }

    .step {
      display: grid;
      grid-template-columns: 54px 1fr;
      gap: 18px;
      padding: 23px;
      border: 1px solid var(--lp-line);
      border-radius: 18px;
      background: #fff;
    }

    .step-index {
      display: grid;
      place-items: center;
      width: 54px;
      height: 54px;
      border-radius: 50%;
      color: #fff;
      background: var(--lp-sage);
      font-weight: 800;
    }

    .step h3 {
      margin: 4px 0 8px;
      color: var(--lp-navy);
    }

    .step p {
      color: var(--lp-muted);
    }

    .dosimetry-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }

    .dosimetry-card {
      padding: 24px;
      border: 1px solid var(--lp-line);
      border-radius: 18px;
      background: #fff;
    }

    .dosimetry-card h3 {
      margin-bottom: 10px;
      color: var(--lp-navy);
    }

    .dosimetry-card p {
      color: var(--lp-muted);
    }

    .flow {
      background: #fff;
    }

    .flow-line {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 11px;
    }

    .flow-item {
      position: relative;
      min-height: 130px;
      padding: 20px 14px;
      border: 1px solid var(--lp-line);
      border-radius: 16px;
      background: var(--lp-bg);
      text-align: center;
    }

    .flow-item::after {
      content: "→";
      position: absolute;
      top: 45%;
      right: -11px;
      color: var(--lp-gold);
      font-size: 1.2rem;
      font-weight: 900;
    }

    .flow-item:last-child::after {
      display: none;
    }

    .flow-item small {
      display: block;
      margin-bottom: 8px;
      color: var(--lp-sage-dark);
      font-weight: 800;
    }

    .flow-item strong {
      color: var(--lp-navy);
      font-size: .94rem;
    }

    .errors {
      color: #fff;
      background: var(--lp-dark);
    }

    .errors .eyebrow { color: #d6be94; }
    .errors .section-head h2 { color: #fff; }
    .errors .section-head p { color: rgba(255,255,255,.74); }

    .error-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 18px;
    }

    .error-item {
      padding: 24px;
      border: 1px solid rgba(255,255,255,.14);
      border-radius: 18px;
      background: rgba(255,255,255,.055);
    }

    .error-item strong {
      display: block;
      margin-bottom: 8px;
      color: #fff;
    }

    .error-item span {
      color: rgba(255,255,255,.72);
    }

    .stage-note {
      padding: 72px 0;
      color: #fff;
      background: linear-gradient(135deg, var(--lp-sage-dark), var(--lp-navy));
    }

    .stage-note-grid {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 36px;
      align-items: center;
    }

    .stage-note h2 {
      color: #fff;
    }

    .stage-note p {
      max-width: 780px;
      margin-top: 15px;
      color: rgba(255,255,255,.76);
    }

    .draft-footer {
      padding: 28px 0;
      color: #fff;
      background: var(--lp-navy);
      text-align: center;
    }

    .draft-footer p {
      color: rgba(255,255,255,.72);
      font-size: .9rem;
    }

    @media (max-width: 980px) {
      .lp-hero-grid,
      .intro-grid,
      .defense-grid {
        grid-template-columns: 1fr;
      }

      .cards,
      .dosimetry-grid {
        grid-template-columns: 1fr 1fr;
      }

      .flow-line {
        grid-template-columns: repeat(2, 1fr);
      }

      .flow-item::after {
        display: none;
      }

      .trust .lp-container {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 650px) {
      .lp-container {
        width: min(100% - 28px, 1180px);
      }

      section {
        padding: 70px 0;
      }

      .cards,
      .notice-grid,
      .dosimetry-grid,
      .flow-line,
      .error-grid,
      .lp-proof {
        grid-template-columns: 1fr;
      }

      .lp-actions .lp-button {
        width: 100%;
      }

      .trust .lp-container {
        grid-template-columns: 1fr;
      }

      .stage-note-grid {
        grid-template-columns: 1fr;
      }

      .comparison-table {
        display: block;
        overflow-x: auto;
      }
    }

    /* ETAPA 2: FAQ, CTA, footer e WhatsApp */
    .faq-section {
      background: #fff;
    }

    .faq-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }

    .faq-item {
      border: 1px solid var(--lp-line);
      border-radius: 16px;
      overflow: hidden;
      background: var(--lp-bg);
    }

    .faq-item summary {
      display: flex;
      justify-content: space-between;
      gap: 20px;
      padding: 21px;
      cursor: pointer;
      list-style: none;
      color: var(--lp-navy);
      font-weight: 750;
    }

    .faq-item summary::-webkit-details-marker {
      display: none;
    }

    .faq-item summary span {
      color: var(--lp-sage);
      font-size: 1.35rem;
      transition: transform .2s ease;
    }

    .faq-item[open] summary span {
      transform: rotate(45deg);
    }

    .faq-answer {
      padding: 0 21px 21px;
      color: var(--lp-muted);
    }

    .final-cta {
      padding: 72px 0;
      color: #fff;
      background: linear-gradient(135deg, var(--lp-sage-dark), var(--lp-navy));
    }

    .final-cta-grid {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 36px;
      align-items: center;
    }

    .final-cta h2 {
      color: #fff;
    }

    .final-cta p {
      max-width: 780px;
      margin-top: 15px;
      color: rgba(255,255,255,.76);
    }

    .related-section {
      background: var(--lp-soft);
    }

    .related-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }

    .related-card {
      padding: 24px;
      border: 1px solid var(--lp-line);
      border-radius: 18px;
      background: #fff;
    }

    .related-card h3 {
      margin-bottom: 10px;
      color: var(--lp-navy);
    }

    .related-card p {
      margin-bottom: 18px;
      color: var(--lp-muted);
    }

    .related-card a {
      color: var(--lp-sage-dark);
      font-weight: 800;
      text-decoration: none;
    }

    .site-footer {
      padding: 42px 0 24px;
      color: rgba(255,255,255,.78);
      background: var(--lp-navy);
      border-top: 1px solid rgba(255,255,255,.08);
    }

    .footer-grid {
      display: grid;
      grid-template-columns: 1.2fr .8fr .8fr;
      gap: 36px;
      padding-bottom: 28px;
      border-bottom: 1px solid rgba(255,255,255,.12);
